{
  "name": "open-sponsor-widget",
  "version": "1.0.0",
  "description": "Reusable React widget to add a sponsored support section to your website.",
  "author": "Rahul",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "react",
    "react-component",
    "react-widget",
    "sponsor",
    "sponsorship",
    "support-widget",
    "buy-me-a-coffee",
    "donation-widget",
    "funding-widget",
    "creator-support",
    "open-source-support",
    "tailwind",
    "typescript",
    "react-18",
    "frontend",
    "ui-component"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "unpkg": "dist/index.umd.js",
  "jsdelivr": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/rahul-vyas-dev/open-sponsor-widget"
  },
  "homepage": "https://github.com/rahul-vyas-dev/open-sponsor-widget#readme",
  "bugs": {
    "url": "https://github.com/rahul-vyas-dev/open-sponsor-widget/issues"
  },
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/react": "^19.2.14",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "rollup": "^4.59.0",
    "rollup-plugin-dts": "^6.3.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "@tailwindcss/postcss": "^4.2.1"
  }
}
